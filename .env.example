# Copiar a .env y completar los valores. El archivo .env no se versiona.
POSTGRES_USER=ticket
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ticket_api
HOST_DB_PORT=5433

PORT=3000
LOG_LEVEL=info

# Secreto para firmar los JWT (mínimo 16 caracteres)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN_SECONDS=3600

# Pasarela de pagos (proyecto externo). Desde Docker, una pasarela local se alcanza con host.docker.internal
PAYMENT_GATEWAY_URL=http://host.docker.internal:8080
PAYMENT_GATEWAY_API_KEY=change-me-gateway-key
PAYMENT_GATEWAY_TIMEOUT_MS=5000

# Reservas: vigencia en minutos y frecuencia del job que libera las vencidas
RESERVATION_TTL_MINUTES=10
MAX_ACTIVE_HOLDS_PER_USER=8

# Segundos que las reservas quedan reclamadas mientras se cobra (debe ser mayor que PAYMENT_GATEWAY_TIMEOUT_MS)
PAYMENT_CLAIM_SECONDS=30
RESERVATION_EXPIRY_INTERVAL_SECONDS=60

# Primer ADMIN (seed al arrancar si no existe ningún ADMIN)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-admin
